<?xml version="1.0" encoding="utf-8"?>
<!-- MD3 slider track: 6dp rounded bar, secondary-container inactive part, primary active part -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background"
        android:height="6dp"
        android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/md_secondary_container" />
        </shape>
    </item>
    <item
        android:id="@android:id/secondaryProgress"
        android:height="6dp"
        android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="100dp" />
                <solid android:color="@color/md_primary_container" />
            </shape>
        </clip>
    </item>
    <item
        android:id="@android:id/progress"
        android:height="6dp"
        android:gravity="center_vertical">
        <clip>
            <selector>
                <item android:state_enabled="false">
                    <shape android:shape="rectangle">
                        <corners android:radius="100dp" />
                        <solid android:color="@color/md_disabled_content" />
                    </shape>
                </item>
                <item>
                    <shape android:shape="rectangle">
                        <corners android:radius="100dp" />
                        <solid android:color="@color/md_primary" />
                    </shape>
                </item>
            </selector>
        </clip>
    </item>
</layer-list>
