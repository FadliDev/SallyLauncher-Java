<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/md_state_pressed_primary">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle"><corners android:radius="100dp" /><solid android:color="@android:color/transparent" /><stroke android:width="1dp" android:color="@color/md_disabled_container" /></shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle"><corners android:radius="100dp" /><solid android:color="@android:color/transparent" /><stroke android:width="2dp" android:color="@color/md_primary" /></shape>
            </item>
            <item>
                <shape android:shape="rectangle"><corners android:radius="100dp" /><solid android:color="@android:color/transparent" /><stroke android:width="1dp" android:color="@color/md_outline" /></shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
