<?xml version="1.0" encoding="utf-8"?>
<!-- MD3 switch track: 52x32, fully rounded. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="100"
    android:exitFadeDuration="100">
    <item android:state_enabled="false" android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/md_disabled_container" />
            <size android:width="52dp" android:height="32dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@color/md_disabled_container" />
            <size android:width="52dp" android:height="32dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/md_primary" />
            <size android:width="52dp" android:height="32dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/md_surface_container_highest" />
            <stroke android:width="2dp" android:color="@color/md_outline" />
            <size android:width="52dp" android:height="32dp" />
        </shape>
    </item>
</selector>
