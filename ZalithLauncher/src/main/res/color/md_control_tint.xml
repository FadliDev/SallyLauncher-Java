<?xml version="1.0" encoding="utf-8"?>
<!-- Checkbox / radio tint: primary when checked, outline when not, muted when disabled -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/md_disabled_content" />
    <item android:state_checked="true" android:color="@color/md_primary" />
    <item android:color="@color/md_outline" />
</selector>
