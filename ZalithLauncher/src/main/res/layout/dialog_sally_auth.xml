<?xml version="1.0" encoding="utf-8"?>
<!--
  Sally Auth dialog.
  Title + footer are pinned; only the body scrolls, so Cancel / Save can never be pushed off-screen.
  Skin and cape sit side by side (two cards) to keep the dialog short in landscape.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/dialog_min_width"
    android:padding="@dimen/_20sdp">
    <TextView
        android:id="@+id/title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:singleLine="true"
        android:textSize="@dimen/_14ssp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="New Sally Auth account" />
    <ScrollView
        android:id="@+id/body_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:fadeScrollbars="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_text"
        app:layout_constraintVertical_bias="0.0">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_4sdp">
            <TextView
                android:id="@+id/name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_4sdp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sally_auth_username" />
            <com.movtery.zalithlauncher.ui.view.AnimEditText
                android:id="@+id/name_edit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/background_edit_box"
                android:hint="@string/sally_auth_username_hint"
                android:imeOptions="flagNoExtractUi"
                android:inputType="textVisiblePassword"
                android:maxLength="16"
                android:paddingHorizontal="@dimen/_10sdp"
                android:singleLine="true"
                tools:ignore="LabelFor" />
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <!-- Skin -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:background="@drawable/background_card_filled"
                    android:orientation="vertical"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/skin_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/sally_auth_skin" />
                    <TextView
                        android:id="@+id/skin_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:alpha="0.75"
                        android:textSize="@dimen/_10ssp"
                        tools:text="Default skin" />
                    <com.movtery.zalithlauncher.ui.view.AnimButton
                        android:id="@+id/choose_skin_button"
                        style="@style/Widget.Zalith.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:paddingHorizontal="@dimen/_8sdp"
                        android:singleLine="true"
                        android:text="@string/sally_auth_choose_skin" />
                    <com.movtery.zalithlauncher.ui.view.AnimButton
                        android:id="@+id/reset_skin_button"
                        style="@style/Widget.Zalith.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:paddingHorizontal="@dimen/_8sdp"
                        android:singleLine="true"
                        android:text="@string/sally_auth_reset_skin" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <!-- Cape -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:background="@drawable/background_card_filled"
                    android:orientation="vertical"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/cape_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/sally_auth_cape" />
                    <TextView
                        android:id="@+id/cape_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:alpha="0.75"
                        android:textSize="@dimen/_10ssp"
                        tools:text="No cape" />
                    <com.movtery.zalithlauncher.ui.view.AnimButton
                        android:id="@+id/choose_cape_button"
                        style="@style/Widget.Zalith.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:paddingHorizontal="@dimen/_8sdp"
                        android:singleLine="true"
                        android:text="@string/sally_auth_choose_cape" />
                    <com.movtery.zalithlauncher.ui.view.AnimButton
                        android:id="@+id/remove_cape_button"
                        style="@style/Widget.Zalith.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:paddingHorizontal="@dimen/_8sdp"
                        android:singleLine="true"
                        android:text="@string/sally_auth_remove_cape" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.movtery.zalithlauncher.ui.view.AnimButton
            android:id="@+id/cancel_button"
            style="@style/Widget.Zalith.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:text="@android:string/cancel" />
        <com.movtery.zalithlauncher.ui.view.AnimButton
            android:id="@+id/save_button"
            style="@style/Widget.Zalith.Button.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/_72sdp"
            android:text="@string/generic_save" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
