<?xml version='1.0' encoding='utf-8'?>
<resources>

    <!-- ============================================================ -->
    <!--  Material Design 3 theme (light/dark resolved via colors)    -->
    <!-- ============================================================ -->
    <style name="AppTheme" parent="@style/Theme.Material3.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:colorBackground">@color/md_surface</item>

        <!-- Color roles -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorAccent">@color/md_primary</item>

        <!-- Legacy / framework mappings -->
        <item name="colorControlNormal">@color/md_on_surface_variant</item>
        <item name="colorControlActivated">@color/md_primary</item>
        <item name="colorControlHighlight">@color/md_state_pressed_primary</item>
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>
        <item name="android:textColorHint">@color/md_on_surface_variant</item>
        <item name="android:textColorHighlight">@color/md_primary_container</item>
        <item name="android:textColorLink">@color/md_primary</item>
        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
        <item name="android:windowLightStatusBar">@bool/md_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/md_light_bars</item>
        <item name="android:scrollbarThumbHorizontal">@drawable/md_scrollbar_thumb</item>
        <item name="android:scrollbarThumbVertical">@drawable/md_scrollbar_thumb</item>
        <item name="android:textSize">@dimen/_12ssp</item>

        <!-- Component styles -->
        <item name="buttonStyle">@style/Widget.Zalith.Button</item>
        <item name="android:buttonStyle">@style/Widget.Zalith.Button</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Zalith.Button.Text</item>
        <item name="buttonBarButtonStyle">@style/Widget.Zalith.Button.Text</item>
        <item name="imageButtonStyle">@style/Widget.Zalith.IconButton</item>
        <item name="android:imageButtonStyle">@style/Widget.Zalith.IconButton</item>
        <item name="editTextStyle">@style/Widget.Zalith.EditText</item>
        <item name="android:editTextStyle">@style/Widget.Zalith.EditText</item>
        <item name="android:progressBarStyleHorizontal">@style/Widget.Zalith.ProgressBar.Horizontal</item>
        <item name="android:progressBarStyle">@style/Widget.Zalith.ProgressBar.Circular</item>
        <item name="android:progressBarStyleSmall">@style/Widget.Zalith.ProgressBar.Circular</item>
    </style>

    <!-- ============================================================ -->
    <!--  Buttons                                                     -->
    <!-- ============================================================ -->
    <!-- Default = MD3 tonal button -->
    <style name="Widget.Zalith.Button" parent="@style/Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/md_btn_text_tonal</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">@dimen/_32sdp</item>
        <item name="android:minWidth">@dimen/_56sdp</item>
        <item name="android:paddingStart">@dimen/_16sdp</item>
        <item name="android:paddingEnd">@dimen/_16sdp</item>
        <item name="android:paddingTop">@dimen/_4sdp</item>
        <item name="android:paddingBottom">@dimen/_4sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Zalith.Button.Tonal" />

    <style name="Widget.Zalith.Button.Filled">
        <item name="animButtonVariant">filled</item>
        <item name="android:background">@drawable/md_btn_filled</item>
        <item name="android:textColor">@color/md_btn_text_filled</item>
    </style>

    <style name="Widget.Zalith.Button.Outlined">
        <item name="animButtonVariant">outlined</item>
        <item name="android:background">@drawable/md_btn_outlined</item>
        <item name="android:textColor">@color/md_btn_text_outlined</item>
    </style>

    <style name="Widget.Zalith.Button.Text">
        <item name="animButtonVariant">text</item>
        <item name="android:background">@drawable/md_btn_text</item>
        <item name="android:textColor">@color/md_btn_text_text</item>
        <item name="android:minWidth">@dimen/_48sdp</item>
        <item name="android:paddingStart">@dimen/_12sdp</item>
        <item name="android:paddingEnd">@dimen/_12sdp</item>
    </style>

    <style name="Widget.Zalith.Button.Destructive">
        <item name="animButtonVariant">destructive</item>
        <item name="android:background">@drawable/md_btn_destructive</item>
        <item name="android:textColor">@color/md_btn_text_destructive</item>
    </style>

    <style name="Widget.Zalith.IconButton" parent="@style/Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/md_icon_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/md_on_surface_variant</item>
    </style>

    <!-- ============================================================ -->
    <!--  Text fields / progress                                      -->
    <!-- ============================================================ -->
    <style name="Widget.Zalith.EditText" parent="@style/Widget.AppCompat.EditText">
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:textColorHint">@color/md_on_surface_variant</item>
        <item name="android:textCursorDrawable">@drawable/md_cursor</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="Widget.Zalith.ProgressBar.Horizontal" parent="@android:style/Widget.Material.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/md_primary</item>
        <item name="android:progressBackgroundTint">@color/md_secondary_container</item>
        <item name="android:indeterminateTint">@color/md_primary</item>
        <item name="android:secondaryProgressTint">@color/md_primary_container</item>
    </style>

    <style name="Widget.Zalith.ProgressBar.Circular" parent="@android:style/Widget.Material.ProgressBar">
        <item name="android:indeterminateTint">@color/md_primary</item>
    </style>

    <!-- ============================================================ -->
    <!--  Dialogs (MD3: 28dp container, surface-container-high)       -->
    <!-- ============================================================ -->
    <style name="CustomDialogStyle" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowAnimationStyle">@style/Zalith.DialogAnimation</item>
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorSurface">@color/md_surface_container_high</item>
        <item name="colorControlActivated">@color/md_primary</item>
        <item name="buttonBarButtonStyle">@style/Widget.Zalith.Button.Text</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Zalith.Button.Text</item>
        <item name="buttonStyle">@style/Widget.Zalith.Button</item>
        <item name="android:buttonStyle">@style/Widget.Zalith.Button</item>
        <item name="editTextStyle">@style/Widget.Zalith.EditText</item>
        <item name="android:editTextStyle">@style/Widget.Zalith.EditText</item>
        <item name="android:scrollbarThumbVertical">@drawable/md_scrollbar_thumb</item>
        <item name="android:scrollbarThumbHorizontal">@drawable/md_scrollbar_thumb</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowAnimationStyle">@style/Zalith.DialogAnimation</item>
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorSurface">@color/md_surface_container_high</item>
        <item name="colorControlActivated">@color/md_primary</item>
        <item name="buttonBarButtonStyle">@style/Widget.Zalith.Button.Text</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Zalith.Button.Text</item>
        <item name="android:scrollbarThumbVertical">@drawable/md_scrollbar_thumb</item>
        <item name="android:scrollbarThumbHorizontal">@drawable/md_scrollbar_thumb</item>
    </style>

    <style name="Zalith.DialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- ============================================================ -->
    <!--  Text appearances (MD3 type scale, mapped to ssp)            -->
    <!-- ============================================================ -->
    <style name="TextAppearance.Zalith.HeadlineSmall" parent="">
        <item name="android:textSize">@dimen/_16ssp</item>
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.Zalith.TitleMedium" parent="">
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Zalith.BodyMedium" parent="">
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.Zalith.LabelMedium" parent="">
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ============================================================ -->
    <!--  Shared list / settings typography (MD3)                     -->
    <!-- ============================================================ -->
    <!-- list item headline (settings row title) -->
    <style name="TextAppearance.Zalith.SettingTitle" parent="">
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <!-- list item supporting text -->
    <style name="TextAppearance.Zalith.SettingSummary" parent="">
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <!-- section / category header (label large, primary) -->
    <style name="TextAppearance.Zalith.SectionHeader" parent="">
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:textColor">@color/md_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    <!-- navigation drawer label -->
    <style name="TextAppearance.Zalith.NavLabel" parent="">
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <!-- screen / dialog title -->
    <style name="TextAppearance.Zalith.TitleLarge" parent="">
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ============================================================ -->
    <!--  Switch (MD3: 52x32 track, state-dependent thumb)            -->
    <!-- ============================================================ -->
    <style name="Widget.Zalith.Switch" parent="@android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:track">@drawable/md_switch_track</item>
        <item name="android:thumb">@drawable/md_switch_thumb</item>
        <item name="android:thumbTint">@null</item>
        <item name="android:trackTint">@null</item>
        <item name="android:showText">false</item>
        <item name="android:splitTrack">false</item>
        <item name="android:switchMinWidth">52dp</item>
        <item name="android:thumbTextPadding">0dp</item>
        <item name="android:switchPadding">@dimen/_12sdp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:background">@null</item>
    </style>

    <style name="Widget.Zalith.SwitchCompat" parent="@style/Widget.AppCompat.CompoundButton.Switch">
        <item name="track">@drawable/md_switch_track</item>
        <item name="android:thumb">@drawable/md_switch_thumb</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
        <item name="showText">false</item>
        <item name="splitTrack">false</item>
        <item name="switchMinWidth">52dp</item>
        <item name="thumbTextPadding">0dp</item>
        <item name="switchPadding">@dimen/_12sdp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="Widget.Zalith.SeekBar" parent="@android:style/Widget.Material.SeekBar">
        <item name="android:progressTint">@color/md_primary</item>
        <item name="android:progressBackgroundTint">@color/md_secondary_container</item>
        <item name="android:thumbTint">@color/md_primary</item>
    </style>

    <!-- ============================================================ -->
    <!--  Image shapes                                                -->
    <!-- ============================================================ -->
    <style name="RoundedCornersImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="RoundImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
